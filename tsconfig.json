{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "moduleResolution": "bundler",
    "customConditions": [
      "react-native"
    ],
    "moduleSuffixes": [
      ".native",
      ""
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
